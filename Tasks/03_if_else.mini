let age = 19;
let has_id = true;

// if с веткой else
if age >= 18 && has_id {
    print "Доступ разрешён. Проходите.";
} else {
    print "Доступ запрещён. Несовершеннолетним и без ID вход воспрещён.";
}

// if без else (ветка не выполняется)
let score = 42;
if score > 50 {
    print "Вы прошли тест!";
}

print "Конец проверки.";