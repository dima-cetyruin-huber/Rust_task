// Объявление переменных
let a = 10;
let b = 20;

// Простые арифметические операции
print a + b;      // 30
print a - b;      // -10
print a * b;      // 200
print b / a;      // 2
print b % a;      // 0

// Унарный минус и скобки (проверка приоритета)
print -(a + b) * 2; // -60
print (a + b) * (a - b); // -300