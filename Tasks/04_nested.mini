let level = 2;
let score = 850;

if level == 1 {
    print "Лёгкий уровень. Цель: 100 очков.";
    if score > 100 {
        print "Победа на лёгком уровне!";
    } else {
        print "Попробуй ещё раз.";
    }
} else if level == 2 {
    print "Средний уровень. Цель: 500 очков.";
    if score > 500 {
        print "Победа на среднем уровне!";
        
        // Эта переменная существует только внутри этого блока if
        let bonus = score * 10;
        print "Твой бонус: ";
        print bonus;
    } else {
        print "Нужно больше очков.";
    }
} else {
    print "Сложный уровень. Удачи!";
}

print "Игра окончена.";